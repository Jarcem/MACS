# macs-tower 配置样例（P1-8）。复制为 .env 后按需修改
# 云端库：PG 可用时填 postgresql://macs:macs_dev_only@127.0.0.1:5432/macs_tower
# 缺省（或保持下行）→ 自动降级本地 SQLite 文件（V3.4 决策）
DATABASE_URL="file:./macs-tower.db"
# 端口口径（主设计附录 A · Q9）
MACS_TOWER_UDP_PORT=8470
MACS_TOWER_HTTP_PORT=8471

# ── 质量管线（M3，10.3 开关）──
# 独立复核（feature.review.enabled，默认 true）
MACS_FEATURE_REVIEW=1
# 云端抽查（feature.spot_check.enabled，默认 false；Q7 抽样比例 20%）
MACS_FEATURE_SPOT_CHECK=0
MACS_SPOT_CHECK_RATIO=20
# 复核最大打回轮次（Q5 默认 3 轮）
MACS_MAX_REVIEW_ROUNDS=3

# ── 调度与并行（M4，6.4.7/6.4.8）──
# 广播下发 first-ACK-wins（udp.broadcast_mode.enabled，默认 true；false = 点名单播）
MACS_BROADCAST_ENABLED=1
# 全局负载再平衡（cluster.rebalance.enabled，默认 true，每 30s）
MACS_REBALANCE_ENABLED=1
# Worker TTL（Q3 默认 30 分钟，超时销毁 + 子任务按 E01 重试）
MACS_SUBTASK_TTL_MIN=30
# 子任务失败重试上限（E01，指数退避 30s×2^n 封顶 10 分钟）
MACS_MAX_RETRIES=3

# ── 鉴权（§6.4.16 Admin Token read/ops/danger 三级 scope）──
# 引导 danger 令牌；为空且库中无令牌 = 开发模式放行（Quickstart 兼容）
MACS_ADMIN_TOKEN=""

# ── 命令终端（模块 #32，§6.4.14）──
# 每终端独立密钥经 POST /api/v1/command-terminals 登记时生成（一次性展示）
# 此处可留空；如需 .env 预共享协作模式再填写
MACS_CMDTERM_SECRET=""

# ── 通知（§6.4.17 C9，webhook 单通道先行）──
# 经 POST /api/v1/... 登记 notify_channels（config={"url":"https://..."}）
