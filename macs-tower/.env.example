# macs-tower 配置样例（P1-8）。复制为 .env 后按需修改
# 云端库：PG 可用时填 postgresql://macs:macs_dev_only@127.0.0.1:5432/macs_tower
# 缺省（或保持下行）→ 自动降级本地 SQLite 文件（V3.4 决策）
DATABASE_URL="file:./macs-tower.db"
# 端口口径（主设计附录 A · Q9）
MACS_TOWER_UDP_PORT=8470
MACS_TOWER_HTTP_PORT=8471
# 管理后台 Admin Token（/api/v1 鉴权）
MACS_ADMIN_TOKEN="change-me"
# 与 macs-cmdterm 共享的指令签名密钥（模块 #32）
MACS_CMDTERM_SECRET="change-me"
