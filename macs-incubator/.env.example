# macs-incubator 配置样例（P1-8）。复制为 .env 后按需修改
MACS_TOWER_HOST=127.0.0.1
MACS_TOWER_PORT=8470
# 本机孵化器身份与并发上限（Q4 默认 4；incubator_id 由塔侧注册后下发）
MACS_INCUBATOR_NAME="dev-incubator"
MACS_MAX_WORKERS=4
# 注册令牌（6.4.2 注册流程）
MACS_INCUBATOR_TOKEN=""

# ── 本机 Agent 接入（M2.5）──
# cli_agent 默认关闭，显式开闸（安全默认值）
MACS_ALLOW_CLI_AGENT=""
# 命令首 token 白名单（逗号分隔可执行文件名）
MACS_AGENT_ALLOW=""

# ── 协议驱动凭据（M6 §6.4.9；只存本机 env，不进 dispatch payload、不上塔）──
# OpenAI Chat Completions 及兼容网关（base_url 可指向任意兼容服务）
MACS_OPENAI_API_KEY=""
MACS_OPENAI_BASE_URL="https://api.openai.com/v1"
MACS_OPENAI_MODEL=""
# Anthropic Messages API（anthropic-version: 2023-06-01 头协商）
MACS_ANTHROPIC_API_KEY=""
MACS_ANTHROPIC_BASE_URL="https://api.anthropic.com"
MACS_ANTHROPIC_MODEL=""
